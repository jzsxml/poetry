DB_HOST=localhost
DB_PORT=3308
DB_DATABASE=poetry
DB_USERNAME=root
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# SQLite 源库（composer run migrate）；路径相对本项目根目录
POETRY_SQLITE_PATH=./storage/poetry.db

# 迁移加速（可选）
# MIGRATE_ROWS_PER_INSERT=120
# MIGRATE_COMMIT_EVERY=6000
# MIGRATE_BODY_MAX=0

# 站点对外 URL（canonical 等）
SITE_URL=http://localhost:8080

# 时令荐诗：文件缓存 TTL（秒）、HTTP Cache-Control max-age
# RECOMMEND_CACHE_TTL=86400
# RECOMMEND_HTTP_MAX_AGE=3600
# SEASON_POOL_SIZE=96

# 随机一首：预采样池大小；无池时从前 N 条 id 中抽样（非全表 RAND）
# RANDOM_POOL_SIZE=384
# RANDOM_FALLBACK_SAMPLE=2048

# 检索：总数封顶（10001=显示超过1万）、total 缓存秒数、最多可翻页条数
# SEARCH_TOTAL_CAP=10001
# SEARCH_TOTAL_CACHE_TTL=1800
# SEARCH_BROWSE_MAX=500
