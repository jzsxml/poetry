{
  "name": "poetry/poetry-php",
  "description": "中华古诗词库 PHP+MySQL 线路（与 web/ Next 并行）",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.6",
    "overtrue/php-opencc": "^1.3",
    "6tail/lunar-php": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Poetry\\": "src/"
    }
  },
  "scripts": {
    "migrate": "php scripts/migrate-from-sqlite.php",
    "rebuild-author-wall": "php scripts/rebuild-author-wall-stats.php",
    "ensure-search-indexes": "php scripts/ensure-search-indexes.php",
    "repair-paragraphs": "php scripts/repair-paragraphs-from-data.php",
    "serve": "php -S localhost:8080 -t public"
  }
}
